#
# SCAM rootfs config template.
# 'make petalinux-config' copies this to rootfs_config.
#
CONFIG_packagegroup-petalinux=y
CONFIG_packagegroup-petalinux-networking=y

# SSH + sudo
CONFIG_openssh-sshd=y
CONFIG_openssh-sftp-server=y
CONFIG_sudo=y

# Python for quick scripting on target
CONFIG_python3=y
CONFIG_python3-modules=y

# Login. The image has no usable root password, so this account is the way in
# (serial console and SSH). Change the password after first boot: passwd
CONFIG_ADD_EXTRA_USERS="petalinux:petalinux;"
CONFIG_ADD_USERS_TO_GROUPS="petalinux:audio,video,dialout;"
CONFIG_ADD_USERS_TO_SUDOERS="petalinux"

# Utilities
CONFIG_dosfstools=y
CONFIG_e2fsprogs=y
CONFIG_util-linux-mount=y
CONFIG_procps=y
CONFIG_devmem2=y
