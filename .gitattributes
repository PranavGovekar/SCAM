# Default: normalize to LF on commit, LF on checkout
* text=auto eol=lf

# Force LF for source and scripts
*.vhd   text eol=lf
*.vhdl  text eol=lf
*.v     text eol=lf
*.sv    text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.tcl   text eol=lf
*.xdc   text eol=lf
*.dtsi  text eol=lf
*.dts   text eol=lf
*.bb    text eol=lf
*.bbappend text eol=lf
*.conf  text eol=lf
*.service text eol=lf
Makefile    text eol=lf
*.mk    text eol=lf

# Shell scripts as executable
*.sh    text eol=lf

# Binary assets
*.bit   binary
*.bit.bin binary
*.xsa   binary
*.png   binary
*.jpg   binary
*.pdf   binary
